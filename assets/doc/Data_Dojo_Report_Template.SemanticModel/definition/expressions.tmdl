expression _Source = ```
		let
		    // Connect to the 'Financial Sample.xlsx' file in GitHub
		    Source = Excel.Workbook(Web.Contents(FinancialSample_URL), null, true),
		    // Navigate to the 'financials' table in the file
		    financials_Table = Source{[Item="financials",Kind="Table"]}[Data],
		    // Trim leading and trailing whitespace from column names
		    #"Trim Column Names" = Table.TransformColumnNames(financials_Table, Text.Trim),
		    // Set the data types for the columns in the file
		    #"Set Column Data Types" = Table.TransformColumnTypes(#"Trim Column Names",{{"Segment", type text}, {"Country", type text}, {"Product", type text}, {"Discount Band", type text}, {"Units Sold", type number}, {"Manufacturing Price", type number}, {"Sale Price", type number}, {"Gross Sales", type number}, {"Discounts", type number}, {"Sales", type number}, {"COGS", type number}, {"Profit", type number}, {"Date", type date}, {"Month Number", Int16.Type}, {"Month Name", type text}, {"Year", Int16.Type}}),
		    // Count the days between the latest date in the sample data and yesterday, then add that many days to each date, so the sample data will always appear fresh
		    #"Sync Date To Current" = Table.TransformColumns(#"Set Column Data Types", {{"Date", 
		      each Date.AddDays(_, Duration.Days(Date.From(DateTime.LocalNow()) - List.Max(#"Set Column Data Types"[Date])) - 1
		    ), type date}})
		in
		    #"Sync Date To Current"
		```
