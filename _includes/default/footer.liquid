<footer class="site-footer">
  <p class="text">
    {% assign CurrentYear = site.time | date: '%Y' %}
    {{ "Copyright © " | append: CurrentYear | append: " — " | append: site.title | append: " — All rights reserved." }}</p>
  <div class="footer-icons">
    <ul>
      <!-- Social icons from Font Awesome, if enabled -->
      {% include social/icons.liquid %}
    </ul>
  </div>
  <div class="views" style="padding-top:15px">
    <span class="views">
			{% assign page_path = page.url | downcase %}
			{% if page_path == "/" %}{% assign page_path = "/index.html" %}{% endif %}
			<img src='https://hits.sh/{{ site.url | downcase | replace: "https://", "" | replace: "http://", "" }}{{ page_path }}.svg?label=views&extraCount=1062&color=417eb3' alt="Views" />
    </span>
  </div>
</footer>